#!/bin/bash
# TR-100 Machine Report (macOS, trimmed, privacy-friendly)
# Based on TR-100 Copyright © 2024, U.S. Graphics, LLC. BSD-3-Clause License.

MIN_NAME_LEN=5
MAX_NAME_LEN=13
MAX_DATA_LEN=32
BORDERS_AND_PADDING=7

report_title="APPLE COMPUTER, INC."
report_subtitle="M1 MACHINE REPORT"
model_name="Air"

max_length() {
    local max_len=0
    local len

    for str in "$@"; do
        len=${#str}
        if (( len > max_len )); then
            max_len=$len
        fi
    done

    if [ $max_len -lt $MAX_DATA_LEN ]; then
        printf '%s' "$max_len"
    else
        printf '%s' "$MAX_DATA_LEN"
    fi
}

# All data strings must go here
set_current_len() {
    CURRENT_LEN=$(max_length                                     \
        "$report_title"                                          \
        "$model_name"                                            \
        "$os_name"                                               \
        "$os_kernel"                                             \
        "$cpu_model"                                             \
        "$cpu_cores vCPU(s)"                                     \
        "$gpu_display"                                           \
        "$root_used_gb/$root_total_gb GiB [$disk_percent%]"      \
        "${mem_used_gb}/${mem_total_gb} GiB [${mem_percent}%]"   \
        "$batt_display"                                          \
        "$batt_health"                                           \
        "$sys_uptime"                                            \
    )
}

PRINT_HEADER() {
    local length=$((CURRENT_LEN+MAX_NAME_LEN+BORDERS_AND_PADDING))

    local top="┌"
    local bottom="├"
    for (( i = 0; i < length - 2; i++ )); do
        top+="┬"
        bottom+="┴"
    done
    top+="┐"
    bottom+="┤"

    printf '%s\n' "$top"
    printf '%s\n' "$bottom"
}

PRINT_CENTERED_DATA() {
    local max_len=$((CURRENT_LEN+MAX_NAME_LEN-BORDERS_AND_PADDING))
    local text="$1"
    local total_width=$((max_len + 12))

    local text_len=${#text}
    local padding_left=$(( (total_width - text_len) / 2 ))
    local padding_right=$(( total_width - text_len - padding_left ))

    printf "│%${padding_left}s%s%${padding_right}s│\n" "" "$text" ""
}

PRINT_DIVIDER() {
    # "top" or "bottom"; no argument means middle divider
    local side="$1"
    case "$side" in
        "top")
            local left_symbol="├"
            local middle_symbol="┬"
            local right_symbol="┤"
            ;;
        "bottom")
            local left_symbol="└"
            local middle_symbol="┴"
            local right_symbol="┘"
            ;;
        *)
            local left_symbol="├"
            local middle_symbol="┼"
            local right_symbol="┤"
    esac

    local length=$((CURRENT_LEN+MAX_NAME_LEN+BORDERS_AND_PADDING))
    local divider="$left_symbol"
    for (( i = 0; i < length - 3; i++ )); do
        divider+="─"
        if [ "$i" -eq 14 ]; then
            divider+="$middle_symbol"
        fi
    done
    divider+="$right_symbol"
    printf '%s\n' "$divider"
}

PRINT_DATA() {
    local name="$1"
    local data="$2"
    local max_data_len=$CURRENT_LEN

    local name_len=${#name}
    if (( name_len < MIN_NAME_LEN )); then
        name=$(printf "%-${MIN_NAME_LEN}s" "$name")
    elif (( name_len > MAX_NAME_LEN )); then
        name=$(echo "$name" | cut -c 1-$((MAX_NAME_LEN-3)))...
    else
        name=$(printf "%-${MAX_NAME_LEN}s" "$name")
    fi

    local data_len=${#data}
    if (( data_len >= MAX_DATA_LEN || data_len == MAX_DATA_LEN-1 )); then
        data=$(echo "$data" | cut -c 1-$((MAX_DATA_LEN-3-2)))...
    else
        data=$(printf "%-${max_data_len}s" "$data")
    fi

    printf "│ %-${MAX_NAME_LEN}s │ %s │\n" "$name" "$data"
}

bar_graph() {
    local percent
    local num_blocks
    local width=$CURRENT_LEN
    local graph=""
    local used=$1
    local total=$2

    percent=$(awk -v used="$used" -v total="$total" 'BEGIN { if (total + 0 == 0) print 0; else printf "%.2f", (used / total) * 100 }')

    num_blocks=$(awk -v percent="$percent" -v width="$width" 'BEGIN { n = int((percent / 100) * width); if (n > width) n = width; print n }')

    for (( i = 0; i < num_blocks; i++ )); do
        graph+="█"
    done
    for (( i = num_blocks; i < width; i++ )); do
        graph+="░"
    done
    printf "%s" "${graph}"
}

# Operating System
os_name="macOS $(sw_vers -productVersion)"
os_kernel="$(uname -s) $(uname -r)"

# CPU
cpu_model="$(sysctl -n machdep.cpu.brand_string)"
cpu_cores="$(sysctl -n hw.ncpu)"

# GPU
gpu_info=$(system_profiler SPDisplaysDataType 2>/dev/null)
gpu_model=$(echo "$gpu_info" | awk -F': ' '/Chipset Model/ {print $2; exit}')
gpu_cores=$(echo "$gpu_info" | awk -F': ' '/Total Number of Cores/ {print $2; exit}')
if [ -n "$gpu_cores" ]; then
    gpu_display="$gpu_cores cores"
else
    gpu_display="${gpu_model:-N/A}"
fi

# Memory
mem_total=$(sysctl -n hw.memsize)
mem_total_kb=$((mem_total / 1024))

vm_stat_output=$(vm_stat)
page_size=$(echo "$vm_stat_output" | grep "page size" | awk '{print $8}')

pages_wired=$(echo "$vm_stat_output" | grep "Pages wired down" | awk '{print $4}' | tr -d '.')
pages_active=$(echo "$vm_stat_output" | grep "Pages active" | awk '{print $3}' | tr -d '.')
pages_compressed=$(echo "$vm_stat_output" | grep "Pages occupied by compressor" | awk '{print $5}' | tr -d '.')

mem_used_bytes=$(((pages_wired + pages_active + pages_compressed) * page_size))
mem_used_kb=$((mem_used_bytes / 1024))

mem_percent=$(awk -v used="$mem_used_kb" -v total="$mem_total_kb" 'BEGIN { printf "%.2f", (used / total) * 100 }')
mem_total_gb=$(echo "$mem_total_kb" | awk '{ printf "%.2f", $1 / (1024 * 1024) }')
mem_used_gb=$(echo "$mem_used_kb" | awk '{ printf "%.2f", $1 / (1024 * 1024) }')

# Disk (APFS: the Data volume holds your files; used = total - available)
disk_path="/System/Volumes/Data"
[ -d "$disk_path" ] || disk_path="/"
read -r root_total_gb root_used_gb < <(df -k "$disk_path" | awk 'NR==2 {
    total = $2 / 1048576; avail = $4 / 1048576;
    printf "%.2f %.2f\n", total, total - avail }')
disk_percent=$(awk -v used="$root_used_gb" -v total="$root_total_gb" 'BEGIN { if (total == 0) print "0.00"; else printf "%.2f", (used / total) * 100 }')

# Battery + health (skipped entirely on desktop Macs)
batt_line=$(pmset -g batt | grep "InternalBattery")
batt_display=""
batt_health=""
if [ -n "$batt_line" ]; then
    batt_percent=$(echo "$batt_line" | grep -oE '[0-9]+%' | head -1)
    batt_state=$(echo "$batt_line" | awk -F'; ' '{print $2}')
    batt_display="$batt_percent ($batt_state)"
    batt_health=$(system_profiler SPPowerDataType 2>/dev/null | awk -F': ' '/Condition:/ {print $2; exit}')
    batt_health=${batt_health:-Unknown}
fi

# Uptime
boot_time=$(sysctl -n kern.boottime | awk '{print $4}' | tr -d ',')
current_time=$(date +%s)
uptime_seconds=$((current_time - boot_time))
uptime_days=$((uptime_seconds / 86400))
uptime_hours=$(( (uptime_seconds % 86400) / 3600 ))
uptime_minutes=$(( (uptime_seconds % 3600) / 60 ))

sys_uptime=""
if [ $uptime_days -gt 0 ]; then sys_uptime="${uptime_days}d "; fi
if [ $uptime_hours -gt 0 ]; then sys_uptime="${sys_uptime}${uptime_hours}h "; fi
if [ $uptime_minutes -gt 0 ]; then sys_uptime="${sys_uptime}${uptime_minutes}m"; fi
sys_uptime=$(echo "$sys_uptime" | sed 's/ $//')

# Set width before graphs get calculated
set_current_len

mem_bar_graph=$(bar_graph "$mem_used_kb" "$mem_total_kb")
disk_bar_graph=$(bar_graph "$root_used_gb" "$root_total_gb")

# Machine Report
PRINT_HEADER
PRINT_CENTERED_DATA "$report_title"
PRINT_CENTERED_DATA "$report_subtitle"
PRINT_DIVIDER "top"
PRINT_DATA "MODEL" "$model_name"
PRINT_DATA "OS" "$os_name"
PRINT_DATA "KERNEL" "$os_kernel"
PRINT_DIVIDER
PRINT_DATA "PROCESSOR" "$cpu_model"
PRINT_DATA "CORES" "$cpu_cores vCPU(s)"
PRINT_DATA "GPU" "$gpu_display"
PRINT_DIVIDER
PRINT_DATA "VOLUME" "$root_used_gb/$root_total_gb GiB [$disk_percent%]"
PRINT_DATA "DISK USAGE" "$disk_bar_graph"
PRINT_DIVIDER
PRINT_DATA "MEMORY" "${mem_used_gb}/${mem_total_gb} GiB [${mem_percent}%]"
PRINT_DATA "USAGE" "${mem_bar_graph}"
PRINT_DIVIDER
if [ -n "$batt_display" ]; then
    PRINT_DATA "BATTERY" "$batt_display"
    PRINT_DATA "HEALTH" "$batt_health"
    PRINT_DIVIDER
fi
PRINT_DATA "UPTIME" "$sys_uptime"
PRINT_DIVIDER "bottom"
